-- 4. ระบบเคลื่อนย้ายเมนู (Draggable Menu)
--------------------------------------------------------------------------------
local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

--------------------------------------------------------------------------------
-- 5. ระบบย่อ / ขยายเมนู (Minimize Menu)
--------------------------------------------------------------------------------
local isMinimized = false

toggleBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		container.Visible = false
		mainFrame:TweenSize(UDim2.new(0, 320, 0, 40), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		toggleBtn.Text = "+"
	else
		mainFrame:TweenSize(UDim2.new(0, 320, 0, 260), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true, function()
			container.Visible = true
		end)
		toggleBtn.Text = "-"
	end
end)

--------------------------------------------------------------------------------
-- 6. ฟังก์ชันค้นหารถที่ผู้เล่นกำลังขับอยู่
--------------------------------------------------------------------------------
local function getPlayerVehicle()
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.SeatPart then
			-- หา Model หลักของรถจากตำแหน่งที่นั่ง
			return humanoid.SeatPart:FindFirstAncestorOfClass("Model")
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- 7. ระบบปรับความเร็ว (1 - 300)
--------------------------------------------------------------------------------
applySpeedBtn.MouseButton1Click:Connect(function()
	local speedValue = tonumber(speedInput.Text)
	if not speedValue then return end
	
	-- จำกัดให้อยู่ในช่วง 1 ถึง 300
	speedValue = math.clamp(speedValue, 1, 300)
	speedInput.Text = tostring(speedValue)

	local vehicle = getPlayerVehicle()
	if vehicle then
		-- รองรับระบบรถขับเคลื่อนมาตรฐาน (VehicleSeat)
		local vehicleSeat = vehicle:FindFirstChildOfClass("VehicleSeat", true)
		if vehicleSeat then
			vehicleSeat.MaxSpeed = speedValue
		end

		-- รองรับระบบรถยอดนิยม เช่น A-Chassis / Chassis ต่างๆ
		for _, child in pairs(vehicle:GetDescendants()) do
			if child:IsA("NumberValue") or child:IsA("IntValue") then
				if child.Name:lower():find("speed") or child.Name:lower():find("maxspeed") or child.Name == "Horsepower" then
					child.Value = speedValue
				end
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- 8. ระบบถอดชุดสี / ชิ้นส่วนรถ
--------------------------------------------------------------------------------
removePartsBtn.MouseButton1Click:Connect(function()
	local vehicle = getPlayerVehicle()
	if vehicle then
		for _, part in pairs(vehicle:GetDescendants()) do
			if part:IsA("BasePart") then
				-- ปรับให้ชิ้นส่วนกลายเป็นแบบโปร่งใส (เหมือนถอดออก)
				part.Transparency = 1
			elseif part:IsA("Decal") or part:IsA("Texture") then
				-- ลบสติกเกอร์/ลวดลายสี
				part:Destroy()
			elseif part:IsA("SpecialMesh") then
				-- ลบ Mesh ตกแต่งภายนอก
				part.TextureId = ""
			end
		end
	end
end)
